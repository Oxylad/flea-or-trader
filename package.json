{
  "name": "flea-or-trader",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production bun run server/index.ts",
    "dev": "bun --hot run server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "eval": "bun scripts/eval-recognition.ts --verbose",
    "build:errors": "bun scripts/build-error-pages.ts",
    "pm2:deploy": "bun run build:errors && bun run typecheck && bun test && pm2 startOrReload ecosystem.config.cjs --update-env"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
